# ──────────────────────────────────────────────────────────────────────────────
# NVR — Environment template
#
# Copy to .env and fill in.  `install.sh` does this for you (cp -n) and prompts for
# the required values.  .env is git-ignored — NEVER commit real secrets.
#
#   [REQUIRED] must be set or the stack won't come up correctly.
#   [OPTIONAL] has a sane default; set only if you need to change it.
#
# Passwords that must NOT show up in `docker inspect` live in ./secrets/* (Docker
# secrets), NOT here.  See the "Secrets" note at the bottom.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Image ────────────────────────────────────────────────────────────────────
# nvr-wrapper is BUILT, never pulled: install.sh builds it from the source tree,
# deploy-offline.sh loads it from the bundle's images.tar. No registry, so there is
# no tag/channel to track and no registry credential on the machine.
WRAPPER_IMAGE=nvr-wrapper:latest          # [OPTIONAL] local image name/tag to run

FRIGATE_VERSION=0.16.3                    # [OPTIONAL] Frigate is version-pinned (NOT auto-updated)

# ─── Host network ─────────────────────────────────────────────────────────────
# IP of this Ubuntu host on the LAN — used for WebRTC ICE candidates.
# install.sh auto-detects and fills this; override only for a multi-NIC box.
FRIGATE_HOST_IP=                         # [REQUIRED] e.g. 192.168.1.50
TZ=Asia/Ho_Chi_Minh                      # [OPTIONAL]

# Shown in every Telegram/watchdog alert ([hostname] prefix) so you can tell which physical
# device is reporting. install.sh auto-fills this with the OS hostname — rename it to something
# recognizable (e.g. kho-hanoi, van-phong-hcm) if the machine's hostname isn't meaningful.
HOSTNAME=                                # [OPTIONAL] install.sh auto-fills; blank = "nvr-edge-node" for every machine

# ─── Container registry ───────────────────────────────────────────────────────
# None. GITHUB_USERNAME/GITHUB_TOKEN were removed 2026-08-03: a registry PAT had to
# sit plaintext in .env on every delivered machine to pull the image, so losing one
# box meant losing the shared GitHub account. Images are built/bundled instead, and
# install.sh + deploy-offline.sh strip these two keys if an older .env still has them.

# ─── Khôi phục mật khẩu ───────────────────────────────────────────────────────
# Gmail removed 2026-07-29 — password recovery is offline (recovery code + security
# questions). No mail credentials live on a device any more.

# ─── MQTT nội bộ (mosquitto) ──────────────────────────────────────────────────
# Broker nội bộ yêu cầu đăng nhập (allow_anonymous=false). install.sh tự sinh 2 mật
# khẩu này VÀ file hash mosquitto/config/passwd — không cần điền tay.
MQTT_FRIGATE_PASSWORD=                   # [REQUIRED] install.sh auto-generates
MQTT_BACKEND_PASSWORD=                   # [REQUIRED] install.sh auto-generates

# ─── Telegram (watchdog health/OTA alerts) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=                      # [OPTIONAL] empty = alerts disabled
TELEGRAM_CHAT_ID=                        # [OPTIONAL]

# ─── Overlay network — pick ONE ──────────────────────────────────────────────
# (A) Nebula (MIT) — the locked production overlay. Self-hosted HQ lighthouse +
#     signing service. Setting NEBULA_CA_URL activates Nebula; ZeroTier stands down.
NEBULA_CA_URL=                           # [REQUIRED if Nebula] e.g. http://<hq-ip>:9443
NEBULA_OVERLAY_SUBNET=                   # [REQUIRED if Nebula] e.g. 10.x.y.0/24

# (B) ZeroTier — LEGACY fallback only (kept dormant). Leave blank when using Nebula.
ZT_SCAN_SUBNET=                          # [OPTIONAL] e.g. 10.147.20.0/24
ZT_CONTROLLER_URL=                       # [OPTIONAL] self-hosted ZT controller API
ZT_NETWORK_ID=                           # [OPTIONAL] fleet network id (16-hex)

# ─── Edge gateway scanning (4-6 Plan A) ───────────────────────────────────────
EDGE_AGENT_PORT=9797                     # [OPTIONAL] agent HTTP port on the Pi
GATEWAY_SCAN_INTERVAL_SEC=30             # [OPTIONAL]

# ─── Cổng dịch vụ (đổi 2026-07-29) ────────────────────────────────────────────
#   HTTP  (nginx)              80   → 9000   ← đổi trong nginx/nginx.conf (`listen`)
#   MQTT  (mosquitto)          1883 → 9001   ← cổng HOST; trong container vẫn 1883
#   MQTT/WebSocket             9001 → 9002   ← cổng HOST; trong container vẫn 9001
# HTTPS 443 GIỮ NGUYÊN — người dùng vẫn vào https://<ip>.
# ONVIF_HTTP_PORT phải khớp `listen` của nginx: backend nhúng cổng này vào XAddr ONVIF
# quảng bá cho AiView Box (WS-Discovery). Sai cổng ⇒ Box tìm thấy NVR nhưng không gọi được.
ONVIF_HTTP_PORT=9000                     # [OPTIONAL] mặc định 9000

# ─── Misc ─────────────────────────────────────────────────────────────────────
E2E_TEST_MODE=false                      # [OPTIONAL] true = enable /api/dev/* test endpoints
DC_BRIDGE_PATH=                          # [OPTIONAL] override path to the dc-bridge binary

# ─── Secrets (files under ./secrets/, git-ignored) ────────────────────────────
# install.sh creates these if missing:
#   secrets/edge_agent_token     — shared fleet token for edge gateways (auto-generated)
#   secrets/nebula_sign_token    — Nebula HQ signing-service admin token (auto-generated)
#   secrets/zt_controller_token  — ZeroTier controller token (blank unless using ZeroTier)

# ─── Cập nhật hệ thống (OTA) ─────────────────────────────────────────────────
# Mã model thiết bị. URL manifest scope theo model, và máy TỪ CHỐI mọi gói khai model khác
# (chống cài chéo dòng sản phẩm). BẮT BUỘC — để trống là mọi gói OTA bị từ chối.
DEVICE_MODEL=AIVIEW-NVR-X1

# Gốc URL phát hành. URL manifest đầy đủ = <OTA_BASE_URL>/<DEVICE_MODEL>/OTA/manifest.json
# ⚠ THƯ MỤC PHÁT HÀNH KHÁC MÃ MODEL, và đó là CỐ Ý.
#   thư mục trên server : VMS            (kênh phát hành, dùng chung cả dòng)
#   DEVICE_MODEL        : AIVIEW-NVR-X1  (mã model, thiết bị tự so để chống cài chéo)
# Vì vậy ĐỪNG suy URL manifest bằng cách ghép OTA_BASE_URL với DEVICE_MODEL —
# ra .../download/AIVIEW-NVR-X1/OTA/ là một thư mục KHÔNG tồn tại, và máy sẽ im
# lặng "không có bản mới" mãi mãi. URL thật nằm ở OtaConfig.DEFAULT_MANIFEST_URL
# trong bản build. Watchdog cảnh báo OTA_URL_LECH lúc khởi động nếu hai thứ này
# ghép ra hai URL khác nhau.
OTA_BASE_URL=https://aiview.bkav.com/download

# Ghi đè URL manifest. KHÔNG cần khai để chạy bình thường: địa chỉ thật của dòng sản phẩm
# (.../download/VMS/OTA/manifest.json) đã nằm sẵn trong bản build — xem
# OtaConfig.DEFAULT_MANIFEST_URL. Chỉ đặt khi cần trỏ sang mirror riêng hoặc server test.
#OTA_MANIFEST_URL=https://mirror-noi-bo/OTA/manifest.json

# Trần kích thước gói upload qua Web UI (byte). 4GB đủ cho gói có cả Frigate.
OTA_MAX_UPLOAD_BYTES=4294967296

# Thư mục khoá công khai tin cậy. Do scripts/install-ota.sh ghi (root:root 0444).
OTA_KEYRING_DIR=/opt/nvr/keys/ota-trust.d

# Version của watchdog, đối chiếu với manifest.minApplier.
WATCHDOG_VERSION=1.0.0
