# Copy file này thành .env và điền giá trị
# cp ai-test/.env.template ai-test/.env

# Bắt buộc: Gemini API key (miễn phí, lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Pattern lock của NVR (chuỗi các điểm theo thứ tự vẽ, vd: "0,1,2,3,4")
# Bỏ trống nếu NVR chưa setup pattern lock (fresh install)
NVR_PATTERN=

# URL NVR (mặc định localhost:3000)
# NVR_URL=http://localhost:3000

# Chạy browser có hiện cửa sổ không (false = hiện, true = chạy ngầm)
# HEADLESS=true
