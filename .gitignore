tests/e2e/playwright-report/
tests/e2e/test-results/
android-app/app/build/
android-app/.gradle/

# Internal TLS CA (per-machine, NEVER commit the CA private key)
nginx/ca/

# Per-machine TLS leaf (generated by nginx/gen-tls.sh) — never commit
nginx/server.key
nginx/server.crt

# Offline bundle artifacts
.docker-cache/
nvr-bundle-*.tar.gz
ai-test/.env
ai-test/screenshots/

