#!/usr/bin/env bash
# Pre-commit: chặn commit chứa secret hardcode (token, API key, mật khẩu, private key).
# Sự cố gốc: TELEGRAM_BOT_TOKEN từng bị hardcode thẳng vào deploy/edge_ota_update.sh,
# xoá file không xoá được token khỏi git history — repo public nên bot dò-token lấy được
# và dùng để spam vào chat Telegram của chủ máy. Hook này chặn TỪ LÚC COMMIT, không phải
# dọn sau khi đã lộ.
#
# Bỏ qua 1 lần (chỉ khi chắc chắn là false positive): git commit --no-verify

set -euo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

# format: <nhãn>|<regex ERE>
PATTERNS=(
  "Telegram bot token|[0-9]{8,10}:[A-Za-z0-9_-]{34,35}"
  "GitHub token|gh[pousr]_[A-Za-z0-9]{20,}"
  "AWS access key|AKIA[0-9A-Z]{16}"
  "Google/Gemini API key|AIza[0-9A-Za-z_-]{35}"
  "OpenAI-style API key|sk-[A-Za-z0-9]{20,}"
  "Slack token|xox[baprs]-[A-Za-z0-9-]{10,}"
  "Private key block|-----BEGIN[[:space:]](RSA|EC|OPENSSH|DSA|)[[:space:]]*PRIVATE KEY-----"
  "Gán mật khẩu/token/secret có giá trị thật|(password|passwd|secret|token|api_key|apikey)[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9+/_=-]{12,}[\"']?"
)

# Placeholder hợp lệ — không phải secret thật, không chặn dòng khớp các mẫu này.
ALLOW_RE='\$\{[A-Za-z_][A-Za-z0-9_]*\}|change-?me|YOUR_[A-Z_]+|<[^>]+>|xxx+|\bnull\b|^\s*$|example|placeholder|CHANGE_ME'

FOUND=0
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"
[[ -z "$STAGED_FILES" ]] && exit 0

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  # Bỏ qua binary
  git diff --cached -- "$file" | grep -Iq . || continue

  ADDED_LINES="$(git diff --cached -U0 -- "$file" | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"
  [[ -z "$ADDED_LINES" ]] && continue

  for p in "${PATTERNS[@]}"; do
    label="${p%%|*}"; rx="${p#*|}"
    hit="$(echo "$ADDED_LINES" | grep -E -- "$rx" | grep -viE -- "$ALLOW_RE" || true)"
    if [[ -n "$hit" ]]; then
      echo -e "${RED}[BLOCKED]${NC} $file — nghi ngờ: ${YELLOW}${label}${NC}"
      echo "$hit" | sed 's/^/    /'
      FOUND=1
    fi
  done
done <<< "$STAGED_FILES"

if [[ $FOUND -eq 1 ]]; then
  echo ""
  echo -e "${RED}Commit bị chặn — phát hiện khả năng lộ secret ở trên.${NC}"
  echo "Sửa: chuyển giá trị thật ra .env / secrets/* (đã git-ignore), commit lại placeholder."
  echo "Nếu chắc chắn là false positive: git commit --no-verify"
  exit 1
fi

exit 0
