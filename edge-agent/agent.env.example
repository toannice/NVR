# nvr-edge-agent configuration (copy to /etc/nvr-edge-agent/agent.env)

# Shared fleet token — MUST match the token every NVR uses (NVR side: secrets/edge_agent_token).
# Remote (ZeroTier) callers must present "Authorization: Bearer <this>". Loopback is exempt.
EDGE_AGENT_TOKEN=change-me-to-a-long-random-fleet-secret

# Human label shown in the NVR gateway list (defaults to hostname).
EDGE_AGENT_NAME=gateway-nha-A

# ZeroTier network id. LEAVE EMPTY for the generic multi-region image (cách A): the Android app sets
# the region per-gateway via POST /enroll, and the agent persists it (survives reboot). Set a value
# here ONLY if you want to hard-bake one region into this image — the app can still override it.
# When set (or enrolled), the agent runs `zerotier-cli join` in a retry loop until the zerotier-one
# API is ready. No manual authorize: the Pi shows up as a pending member and the admin clicks
# "Cấp phép" in the NVR Web UI (Plan A — the NVR authorizes it via the controller REST API).
# Self-host controller HQ fleet examples: efb242bde2f3e856 (nvr-fleet, 10.147.20.0/24).
ZT_NETWORK_ID=

# Field LAN subnet (informational + WS-Discovery hint), e.g. 192.168.2.0/24
EDGE_AGENT_FIELD_SUBNET=192.168.2.0/24

# API port (default 9797). The agent binds 0.0.0.0:PORT — reachable on loopback (local field page),
# the ZeroTier IP (NVRs), and the field LAN (the Android onboarding app, which has no fleet token and
# calls /identity + /label — both no-auth by design). Camera/proxy mutation stays behind the token on
# every interface, so the wildcard bind does not widen exposure.
EDGE_AGENT_PORT=9797

# Optional: force the ZeroTier IP instead of autodetecting the zt* interface (used for the nginx
# stream proxy bind + reported in /health, not for the API listener).
#EDGE_AGENT_ZT_IP=10.34.24.12

# Proxy port pool start (default 8080). Reserved ports 1984/8554/8555 are always skipped.
#EDGE_AGENT_POOL_START=8080

# Paths (defaults are fine on a standard install).
#EDGE_AGENT_NGINX_CONF=/etc/nginx/stream.d/cameras.conf
#EDGE_AGENT_STATE=/var/lib/nvr-edge-agent/state.json
