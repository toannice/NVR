# /etc/nebula-hq/signing.env — config for nvr-nebula-signing (HQ control plane).
# Copy to /etc/nebula-hq/signing.env, fill in, chmod 600, then: systemctl restart nvr-nebula-signing

# Bind for the REST API. Keep it reachable by the NVR (admin) + field gateways (enroll). Behind a
# reverse proxy / firewall in production; agents reach it over the public internet during enroll.
NEBULA_SIGN_LISTEN=:9443

# Admin bearer token — MUST match the NVR's secrets/nebula_sign_token. Gates mint/approve/reject.
# Either set inline here or point NEBULA_SIGN_TOKEN_FILE at a 0600 file.
NEBULA_SIGN_TOKEN=
# NEBULA_SIGN_TOKEN_FILE=/etc/nebula-hq/sign_token

# Where the CA cert/key live (<caName>.crt/.key). install-hq.sh creates default.{crt,key} here.
NEBULA_CA_DIR=/etc/nebula-hq/ca

# Persisted tokens + enrollment requests.
NEBULA_SIGN_STATE=/var/lib/nebula-hq/signing-state.json

# The lighthouse PUBLIC endpoint agents must reach (UDP 4242). Use a static public IP or a DDNS name.
NEBULA_LIGHTHOUSE=203.0.113.10:4242
# The lighthouse address ON the overlay (goes into each agent's static_host_map + lighthouse.hosts).
NEBULA_LIGHTHOUSE_OVERLAY_IP=10.10.20.1

# Overlay IPs the allocator must NEVER hand to a gateway — infra nodes signed by hand OUTSIDE this
# service (the NVR, extra services). The NVR is typically 10.10.20.2 (lighthouse .1, gateways .3+).
# WITHOUT this, the first gateway of a pool is allocated .2 and COLLIDES with the NVR (the NVR scanner
# then sees its own IP and never discovers the gateway). Comma-separated. .0/.1/.255 are always skipped.
NEBULA_RESERVED_IPS=10.10.20.2

# Path to the nebula-cert binary (install-hq.sh puts it in /usr/local/bin).
NEBULA_CERT_BIN=/usr/local/bin/nebula-cert

# V3: short-lived certs (nebula-cert sign -duration). Agents auto-renew (R1) before expiry, so a
# revoked gateway falls off within this window even if the blocklist isn't pushed. Default 2160h (90d).
# Empty = nebula-cert default (1 year).
NEBULA_CERT_DURATION=2160h

# V3 fast-cut: /revoke appends the revoked cert's fingerprint here. Wire this file into the lighthouse
# pki.blocklist and reload nebula to cut a stolen gateway immediately (don't wait for cert expiry).
# Empty disables the file write (denylist + short-cert expiry still apply).
# NEBULA_BLOCKLIST_FILE=/etc/nebula-hq/blocklist.txt
