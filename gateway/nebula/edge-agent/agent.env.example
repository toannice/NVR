# /etc/nvr-edge-agent/agent.env — config for the Nebula edge-agent.
# Copy is installed by install.sh; edit then: systemctl restart nvr-edge-agent

# Fleet token — protects camera/proxy mutation (/camera, /discovery) on the field-LAN path. If set it
# MUST match the NVR's secrets/edge_agent_token. The enrollment of a region is NOT done here — the
# Android app does it via POST /enroll (signing URL + one-time token), so this image stays generic.
# G2: leaving this EMPTY is now fine — each Pi auto-generates its own per-gateway token (stored in
# state.json) and the NVR normally reaches the agent over the overlay via the Nebula cert group (G2:C,
# NEBULA_FW_NVR_GROUP). The shared fleet token is only needed for the legacy bearer path.
EDGE_AGENT_TOKEN=

# Optional human label (default = hostname).
EDGE_AGENT_NAME=gateway-nha-A

# Field LAN the cameras live on. Used as a WS-Discovery hint AND (G1) to whitelist /camera targets —
# the gateway refuses to proxy to a localIp outside this subnet. Leave empty to disable the whitelist.
EDGE_AGENT_FIELD_SUBNET=192.168.2.0/24

# G3: minutes after boot that /enroll accepts a NEW region (anti-hijack of an un-adopted gateway).
# After it lapses, reboot the Pi to enroll. 0 disables the lock (always open). Default 30.
# EDGE_AGENT_ENROLL_WINDOW_MIN=30

# G2:C — cert-based auth. When set, the Nebula firewall only admits this group (the NVR's cert group)
# inbound, and the agent trusts overlay requests WITHOUT the fleet token. The NVR cert must be signed
# `-groups <this>` (gateways are signed `gateways`, so one gateway can't reach another's API). Leave
# empty to keep legacy behaviour (any overlay member + shared fleet token).
# NEBULA_FW_NVR_GROUP=nvr

# R1: auto-renew the cert once it's within this many days of expiry (so a fielded fleet never lapses).
# The HQ re-signs the same key with no admin step. 0 disables auto-renew. Default 30.
# NEBULA_RENEW_THRESHOLD_DAYS=30

# --- Nebula (usually leave defaults) ---------------------------------------
# Where the agent writes ca/host cert+key + config.yml, and the nebula-cert binary + tun iface.
# NEBULA_DIR=/etc/nebula
# NEBULA_CERT_BIN=nebula-cert
# NEBULA_IFACE=nebula1
# Override overlay IP detection (normally autodetected from the nebula1 interface):
# EDGE_AGENT_OVERLAY_IP=
